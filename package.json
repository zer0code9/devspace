{
  "name": "devspace",
  "displayName": "Dev Space",
  "description": "A little more VSCode",
  "version": "3.0.0",
  "author": "Devberry",
  "publisher": "SlashDEV",
  "engines": {
    "vscode": "^1.100.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zer0code9/devspace.git"
  },
  "icon": "img/logo.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "Dev Space",
    "Package View",
    "Project Box",
    "Term Pad"
  ],
  "galleryBanner": {
    "color": "#2e2e2e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devspaceContainer",
          "title": "Dev Space",
          "icon": "$(devspace-code)"
        }
      ],
      "panel": [
        {
          "id": "termpadPanel",
          "title": "Terms",
          "icon": "$(devspace-check)"
        }
      ]
    },
    "views": {
      "devspaceContainer": [
        {
          "id": "devspace.packageView",
          "name": "Package View",
          "contextualTitle": "Package View",
          "icon": "$(devspace-node-container)"
        },
        {
          "id": "devspace.hierarchyTree",
          "name": "Hierarchy Tree",
          "contextualTitle": "Hierarchy Tree",
          "icon": "$(devspace-sub-task)"
        }
      ],
      "termpadPanel": [
        {
          "id": "devspace.termPad",
          "name": "Terms",
          "contextualTitle": "Terms",
          "icon": "$(devspace-check)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "devspace.packageView",
        "contents": "Go to a workspace folder that has a package.json/pyproject.toml/Cargo.toml file to get started!\n[Open Folder](command:vscode.openFolder)\n[Add Folder](command:devspace.addFolders)\nYou will be able to see all the dependencies and update or uninstall them. Works with node (npm, bun, yarn), pip (pip, uv), and crate (cargo). To change package managers, go to the Dev Space settings."
      },
      {
        "view": "devspace.termPad",
        "contents": "No terms have been detected in the workspace."
      },
      {
        "view": "devspace.hierarchyTree",
        "contents": "The current file or page doesn't allow symbols. Open a file that has symbols to see the hierarchy tree, like a JS/TS/JSX/TSX file."
      }
    ],
    "commands": [
      {
        "command": "devspace.openDevSpaceSettings",
        "title": "Open Dev Space Settings"
      },
      {
        "command": "devspace.refreshPackageView",
        "title": "Refresh",
        "icon": "$(devspace-refresh)"
      },
      {
        "command": "devspace.openPackageFolder",
        "title": "Open Package Folder",
        "icon": "$(devspace-open-blank)"
      },
      {
        "command": "devspace.changePackageManager",
        "title": "Change Package Manager",
        "icon": "$(devspace-gear)"
      },
      {
        "command": "devspace.showPackageHistory",
        "title": "Show Package History",
        "icon": "$(devspace-clock)"
      },
      {
        "command": "devspace.addPackageItemPrompt",
        "title": "Add",
        "icon": "$(devspace-node-add)"
      },
      {
        "command": "devspace.addPackageItem",
        "title": "Add",
        "icon": "$(devspace-node-add)"
      },
      {
        "command": "devspace.updatePackageItem",
        "title": "Update",
        "icon": "$(devspace-node-change)"
      },
      {
        "command": "devspace.removePackageItem",
        "title": "Remove",
        "icon": "$(devspace-node-remove)"
      },
      {
        "command": "devspace.openPackageItem",
        "title": "Open",
        "icon": "$(devspace-node-search)"
      },
      {
        "command": "devspace.showProjectBox",
        "title": "Show Project Box",
        "icon": "$(devspace-project-container)"
      },
      {
        "command": "devspace.addFoldersBox",
        "title": "Add Folders to Box"
      },
      {
        "command": "devspace.addFoldersBoxUri",
        "title": "Add Folders to Box with URI"
      },
      {
        "command": "devspace.removeFoldersBox",
        "title": "Remove Folders from Box"
      },
      {
        "command": "devspace.addFoldersWorkspace",
        "title": "Add Folder to Workspace"
      },
      {
        "command": "devspace.removeFoldersWorkspace",
        "title": "Remove Folder from Workspace"
      },
      {
        "command": "devspace.showCategories",
        "title": "Show Categories"
      },
      {
        "command": "devspace.refreshTermPad",
        "title": "Refresh",
        "icon": "$(devspace-refresh)"
      },
      {
        "command": "devspace.goToFile",
        "title": "Go to File"
      },
      {
        "command": "devspace.goToTerm",
        "title": "Go to Term"
      },
      {
        "command": "devspace.refreshHierarchyTree",
        "title": "Refresh",
        "icon": "$(devspace-refresh)"
      },
      {
        "command": "devspace.goToSymbol",
        "title": "Go to Symbol"
      }
    ],
    "keybindings": [
      {
        "key": "ctrl+alt+c",
        "command": "workbench.action.showCommands"
      },
      {
        "key": "ctrl+alt+s",
        "command": "devspace.openDevSpaceSettings"
      },
      {
        "key": "ctrl+alt+d",
        "command": "workbench.view.extension.devspaceContainer"
      },
      {
        "key": "ctrl+alt+h",
        "command": "devspace.showPackageHistory"
      },
      {
        "key": "ctrl+alt+b",
        "command": "devspace.showProjectBox"
      },
      {
        "key": "ctrl+alt+w",
        "command": "workbench.explorer.fileView.focus"
      },
      {
        "key": "ctrl+alt+t",
        "command": "workbench.view.extension.termpadPanel"
      },
      {
        "key": "ctrl+alt+p",
        "command": "workbench.actions.view.problems"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devspace.refreshPackageView",
          "when": "view == devspace.packageView",
          "group": "navigation"
        },
        {
          "command": "devspace.openPackageFolder",
          "when": "view == devspace.packageView",
          "group": "navigation"
        },
        {
          "command": "devspace.changePackageManager",
          "when": "view == devspace.packageView",
          "group": "navigation"
        },
        {
          "command": "devspace.showPackageHistory",
          "when": "view == devspace.packageView",
          "group": "navigation"
        },
        {
          "command": "devspace.addPackageItemPrompt",
          "when": "view == devspace.packageView",
          "group": "navigation"
        },
        {
          "command": "devspace.showProjectBox",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation"
        },
        {
          "command": "devspace.refreshTermPad",
          "when": "view == devspace.termPad",
          "group": "navigation"
        },
        {
          "command": "devspace.refreshHierarchyTree",
          "when": "view == devspace.hierarchyTree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "devspace.updatePackageItem",
          "when": "view == devspace.packageView && viewItem == packageItem",
          "group": "inline"
        },
        {
          "command": "devspace.removePackageItem",
          "when": "view == devspace.packageView && viewItem == packageItem",
          "group": "inline"
        },
        {
          "command": "devspace.openPackageItem",
          "when": "view == devspace.packageView && viewItem == packageItem",
          "group": "inline"
        },
        {
          "command": "devspace.goToFile",
          "when": "view == devspace.termPad && viewItem == fileItem"
        }
      ],
      "touchBar": [
        {
          "command": "devspace.showProjectBox",
          "when": "true",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "id": "devspace.settings",
      "title": "Dev Space",
      "properties": {
        "devspace.packageRoot": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "The path to the workspace folder",
          "ignoreSync": true
        },
        "devspace.securedRoot": {
          "type": "boolean",
          "default": false,
          "description": "Whether to use 'sudo' for the package manager",
          "ignoreSync": true
        },
        "devspace.packageManagers": {
          "type": "array",
          "default": [
            "npm",
            "uv",
            "cargo"
          ],
          "description": "The package managers to use for node, pip, and crate",
          "ignoreSync": true
        },
        "devspace.showNewVersions": {
          "type": "boolean",
          "default": true,
          "description": "Whether to show the new version in Package View",
          "ignoreSync": false
        },
        "devspace.showSections": {
          "type": "boolean",
          "default": true,
          "description": "Whether to show sections in Package View",
          "ignoreSync": false
        },
        "devspace.projects": {
          "type": "array",
          "default": [],
          "description": "The saved projects",
          "ignoreSync": true
        },
        "devspace.categorizeProjects": {
          "type": "boolean",
          "default": false,
          "description": "Whether to categorize projects in the Project Box",
          "ignoreSync": true
        },
        "devspace.projectCategories": {
          "type": "array",
          "default": [
            "Uncategorized"
          ],
          "description": "The categories for projects",
          "ignoreSync": true
        },
        "devspace.terms": {
          "type": "array",
          "default": [
            "todo",
            "fixme",
            "debug",
            "review",
            "hack",
            "note"
          ],
          "description": "The terms to look for",
          "ignoreSync": false
        },
        "devspace.autoCollapseTree": {
          "type": "boolean",
          "default": true,
          "description": "Whether to automatically collapse the hierarchy tree symbols that don't reveal the current symbol",
          "ignoreSync": false
        }
      }
    },
    "icons": {
      "devspace-node": {
        "description": "Node",
        "default": {
          "fontPath": "img/devspace.woff",
          "fontCharacter": "\\E100"
